# =============================================================================
# VARIÁVEIS DE AMBIENTE — fome-zero-tech-challenge
# Responsável: Luciano Santiago Barbosa
# =============================================================================
# Como usar:
#   1. cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA versione o arquivo .env no Git (já está no .gitignore)
# =============================================================================

# Banco de Dados (PostgreSQL)
DB_HOST=localhost           # use "postgres" dentro do Docker
DB_PORT=5432                # porta padrão do PostgreSQL
DB_NAME=restaurante_db      # nome do banco de dados
DB_USER=postgres            # usuário do PostgreSQL
DB_PASSWORD=troque_em_producao   # senha — nunca use padrão em produção

# Servidor
SERVER_PORT=8080            # porta da API REST
